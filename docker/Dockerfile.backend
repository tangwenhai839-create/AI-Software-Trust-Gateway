FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app
RUN useradd --create-home --uid 10001 astg

COPY pyproject.toml README.md LICENSE ./
COPY backend ./backend
COPY cli ./cli
COPY rules ./rules
COPY schemas ./schemas
RUN python -m pip install --upgrade pip && python -m pip install -e ".[all]"

RUN mkdir -p /app/artifacts && chown -R astg:astg /app
USER astg

EXPOSE 8000
CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
