# ==========================================
# AI Software Trust Gateway (ASTG) 配置示例
# ==========================================

# 基础服务配置
ASTG_ENV=development
ASTG_HOST=127.0.0.1
ASTG_PORT=8000
ASTG_RELOAD=false
ASTG_CORS_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
ASTG_LOG_LEVEL=INFO

# 数据目录（默认自动使用当前用户可写目录；Windows 为 LocalAppData）
# ASTG_DATA_DIR=C:\Users\你的用户名\AppData\Local\AI Software Trust Gateway
# 数据库配置（不填写时自动保存到 ASTG_DATA_DIR/astg.db，也可切换 PostgreSQL）
# ASTG_DATABASE_URL=sqlite+aiosqlite:///C:/path/to/astg.db
# ASTG_DATABASE_URL=postgresql+asyncpg://astg_user:astg_pass@127.0.0.1:5432/astg_db

# 任务队列配置 (默认使用内置异步队列，可启用 Redis/Celery)
ASTG_QUEUE_MODE=inprocess
# ASTG_QUEUE_MODE=celery
ASTG_REDIS_URL=redis://127.0.0.1:6379/0

# GitHub 与第三方安全配置
# 可选 GitHub Token 用于提高 API 访问限额
GITHUB_TOKEN=
# OSV API 端点
OSV_API_URL=https://api.osv.dev/v1/querybatch

# AI 安全推理配置 (默认关闭云端模型调用，保障本地隐私)
ASTG_AI_ENABLED=false
ASTG_AI_PROVIDER=disabled
# 如启用 OpenAI 兼容提供者 (例如本地 Ollama、vLLM 或 OpenAI API)
# ASTG_AI_PROVIDER=openai_compatible
ASTG_AI_BASE_URL=https://api.openai.com/v1
ASTG_AI_API_KEY=
ASTG_AI_MODEL=gpt-4o-mini
ASTG_AI_TIMEOUT_SECONDS=30

# 存储与限制
# 不填写时自动保存到 ASTG_DATA_DIR/artifacts
# ASTG_ARTIFACTS_DIR=C:\path\to\astg-artifacts
ASTG_MAX_REPO_SIZE_MB=500
ASTG_MAX_REPO_FILES=100000
ASTG_MAX_SINGLE_FILE_MB=10
ASTG_SCAN_TIMEOUT_MINUTES=20
ASTG_REQUIRE_EXTERNAL_SCANNERS=false

# 动态沙箱默认关闭；没有隔离提供者时禁止直接执行被扫描代码
ASTG_DYNAMIC_ENABLED=false
ASTG_DYNAMIC_PROVIDER=disabled
