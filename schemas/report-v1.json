{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ASTGReportV1",
  "type": "object",
  "required": [
    "schema_version",
    "scan_id",
    "target",
    "status",
    "score",
    "summary",
    "findings",
    "dependencies",
    "coverage",
    "generated_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0"] },
    "scan_id": { "type": "string", "format": "uuid" },
    "target": {
      "type": "object",
      "required": ["type", "url", "commit_sha", "languages"],
      "properties": {
        "type": { "type": "string", "enum": ["github", "archive", "local"] },
        "url": { "type": "string" },
        "commit_sha": { "type": "string" },
        "content_sha256": { "type": "string" },
        "languages": { "type": "array", "items": { "type": "string" } }
      }
    },
    "status": {
      "type": "string",
      "enum": ["queued", "ingesting", "scanning", "reasoning", "scoring", "reporting", "completed", "partial", "failed", "cancelled"]
    },
    "score": {
      "type": "object",
      "required": ["safety_score", "risk_score", "risk_level", "confidence", "coverage", "scoring_version"],
      "properties": {
        "safety_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "risk_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "risk_level": { "type": "string", "enum": ["safe", "low", "medium", "high"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "scoring_version": { "type": "string" },
        "components": { "type": "object" },
        "caps_applied": { "type": "array", "items": { "type": "string" } }
      }
    },
    "summary": {
      "type": "object",
      "required": ["conclusion", "top_risks", "recommended_action", "limitations"],
      "properties": {
        "conclusion": { "type": "string" },
        "top_risks": { "type": "array", "items": { "type": "string" } },
        "recommended_action": { "type": "string" },
        "limitations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "fingerprint", "category", "title", "severity", "confidence", "file_path", "line_start", "line_end"],
        "properties": {
          "id": { "type": "string" },
          "fingerprint": { "type": "string" },
          "category": { "type": "string" },
          "title": { "type": "string" },
          "severity": { "type": "string", "enum": ["info", "low", "medium", "high", "critical"] },
          "confidence": { "type": "number" },
          "file_path": { "type": "string" },
          "line_start": { "type": "integer" },
          "line_end": { "type": "integer" },
          "remediation": { "type": "string" },
          "evidences": { "type": "array" },
          "ai_assessment": { "type": "object" }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version", "ecosystem", "scope"],
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" },
          "ecosystem": { "type": "string" },
          "scope": { "type": "string", "enum": ["direct", "indirect", "unresolved"] },
          "manifest_path": { "type": "string" },
          "vulnerabilities": { "type": "array" }
        }
      }
    },
    "provenance": { "type": "object" },
    "ai_analysis": { "type": "object" },
    "coverage": { "type": "object" },
    "generated_at": { "type": "string", "format": "date-time" }
  }
}
