{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ASTGAIInputV1",
  "type": "object",
  "required": [
    "schema_version",
    "scan_id",
    "project_purpose",
    "target",
    "findings",
    "coverage",
    "untrusted_content"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0"] },
    "scan_id": { "type": "string" },
    "project_purpose": {
      "type": "object",
      "required": ["summary", "declared_capabilities", "expected_external_services"],
      "properties": {
        "summary": { "type": "string" },
        "declared_capabilities": { "type": "array", "items": { "type": "string" } },
        "expected_external_services": { "type": "array", "items": { "type": "string" } }
      }
    },
    "target": {
      "type": "object",
      "required": ["type", "languages"],
      "properties": {
        "type": { "type": "string" },
        "commit_sha": { "type": "string" },
        "languages": { "type": "array", "items": { "type": "string" } }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "severity", "evidence_refs"],
        "properties": {
          "id": { "type": "string" },
          "category": { "type": "string" },
          "severity": { "type": "string" },
          "title": { "type": "string" },
          "file_path": { "type": "string" },
          "line_start": { "type": "integer" },
          "evidence_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "coverage": {
      "type": "object",
      "properties": {
        "static": { "type": "number" },
        "dependencies": { "type": "number" },
        "dynamic": { "type": "number" }
      }
    },
    "untrusted_content": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "text"],
        "properties": {
          "source": { "type": "string" },
          "text": { "type": "string" }
        }
      }
    }
  }
}
